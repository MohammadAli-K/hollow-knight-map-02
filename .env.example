# Cloudflare Access settings
# CF_TEAM_NAME: your team name from https://one.dash.cloudflare.com/
#   e.g. if your Zero Trust domain is "myteam.cloudflareaccess.com", use "myteam"
CF_TEAM_NAME=your-team-name

# CF_AUD: the Audience tag from your Cloudflare Access Application settings
#   Found in Zero Trust dashboard → Access → Applications → your app → Overview
CF_AUD=your-audience-tag-here

# Port the server listens on
PORT=3000
